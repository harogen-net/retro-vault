{
  "name": "retro-vault",
  "private": true,
  "version": "0.0.1α",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "echo \"[deploy] id: $(sed -n 's/.*\"deployId\": \"\\([^\"]*\\)\".*/\\1/p' dist/version.json)\" && rm -rf node_modules/.cache/gh-pages && gh-pages -d dist -r https://harogen-net@github.com/harogen-net/retro-vault.git"
  },
  "dependencies": {
    "@ionic/react": "^8.8.8",
    "@ionic/react-router": "^8.8.8",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "ionicons": "^8.0.13",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
